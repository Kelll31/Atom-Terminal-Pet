# IP-адрес компьютера, где запущен сервер Патрика. Зашивается в прошивку.
SERVER_IP=192.168.1.100

# Данные Wi-Fi сети. По умолчанию в прошивку они НЕ попадают: firmware.bin лежит
# в репозитории и раздаётся панелью по HTTP, а пароль внутри образа достаётся
# обычным `strings`. Штатный путь — передать сеть устройству по USB на вкладке
# «Прошивка», оно сохранит её в своей памяти.
WIFI_SSID=MyWiFiNetwork
WIFI_PASS=MyWiFiPassword

# Раскомментируйте, только если для отладки нужно зашить сеть прямо в образ.
# Такой firmware.bin нельзя коммитить и нельзя раздавать через панель.
# EMBED_WIFI=1

# Ключи от нейросетей
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Мозг питомца выбирается в панели: Настройки → Модель. Локальному серверу
# (LM Studio/Bionic — http://127.0.0.1:1234/v1, Ollama — :11434/v1) ключ не нужен:
# нажмите «Найти локальную модель», и адрес подставится сам.
# Переменные окружения ATOM_API_KEY и ATOM_BASE_URL используются, если в
# backend/settings.json пусто — задавать их надо в системе, не в этом файле.